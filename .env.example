# Application environment: local or prod
APP_ENV=local
# Standard Python logging level
LOG_LEVEL=INFO
# Qdrant endpoint; :memory: uses an in-process store
QDRANT_URL=:memory:
# Optional Qdrant credential (replace placeholder when required)
QDRANT_API_KEY=replace-with-qdrant-key
# Collection for document vectors
QDRANT_COLLECTION=documents
# SQLAlchemy database connection URL
DATABASE_URL=sqlite:///./data/app.db
# Provider credentials (replace placeholders before using providers)
GROQ_API_KEY=replace-with-groq-key
GEMINI_API_KEY=replace-with-gemini-key
# Primary and fallback generation models
LLM_PRIMARY_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=gemini-2.0-flash
# Embedding and reranking models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Chunking mode: structure or fixed
CHUNK_STRATEGY=structure
# Chunk length and overlap
CHUNK_SIZE=400
# Minimum tokens for structure-aware chunks (must be less than chunk size)
CHUNK_MIN_TOKENS=80
CHUNK_OVERLAP=60
# Number of retrieval candidates
RETRIEVAL_TOP_K=10
# Request timeout in seconds
REQUEST_TIMEOUT_S=30.0

EMBEDDING_BATCH_SIZE=64
CANDIDATE_K=50
RRF_K=60
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=1.0
MMR_LAMBDA=0.7
MAX_CHUNKS_PER_DOC=3
RERANK_ENABLED=true
RERANK_TOP_N=30
BM25_K1=1.2
BM25_B=0.75
ENTITY_BOOST=0.15
QUERY_CACHE_SIZE=1024
